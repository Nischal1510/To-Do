<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>List Of Users</title>
</head>

<body>
    <h1>List Of Users</h1>
        <table>
            <thead>
                <th>S.No</th>
                <th>Name</th>
                <th>Email</th>
            </thead>
            <tbody>
                <% user.forEach((u,index)=> { %>
                    <tr>
                        <td>
                            <%= index + 1 %>
                        </td>
                        <td>
                            <%= u.name %>
                        </td>
                        <td>
                            <%= u.email %>
                        </td>
                    </tr>
                    <% }); %>
            </tbody>
        </table>
</body>

</html>